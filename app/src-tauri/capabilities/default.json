{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Reference app: open links in the browser, Instagram, Telegram, phone and SMS apps",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://*" },
        { "url": "http://*" },
        { "url": "tel:*" },
        { "url": "sms:*" }
      ]
    }
  ]
}
